// Mirror cover, preserve every road connection, and keep two separate flanks.
void buildMap() {
  mapSeed=FIXED_SEED>=0 ? (FIXED_SEED+(stage-1)*1009)%1000000 : (int)random(1000000);
  generateMap(mapSeed);
}
void generateMap(int seed) {
  mapSeed=seed;
  java.util.Random rng=new java.util.Random(seed);
  for(int y=0;y<N;y++) for(int x=0;x<N;x++) map[y][x]=0;
  baseWall(1);
  int coverRow=3+rng.nextInt(3);
  macro(6,coverRow,1);
  ArrayList<Integer> cells=new ArrayList<Integer>();
  for(int r=1;r<=9;r++) for(int c=0;c<=6;c++) {
    if(r==1 && (c==0 || c==6)) continue;
    if(c==6 && r==coverRow) continue;
    cells.add(r*13+c);
  }
  java.util.Collections.shuffle(cells,rng);
  int target=48+rng.nextInt(7), blocks=1, hard=0;
  for(int id:cells) {
    if(blocks>=target) break;
    int c=id%13,r=id/13,mirror=12-c,n=c==mirror?1:2;
    int roll=rng.nextInt(100);
    int kind=roll<64 || hard+n>16 ? 1 : roll<86 ? 2 : 3;
    macro(c,r,kind); macro(mirror,r,kind);
    if(validRoads()) { blocks+=n; if(kind!=1) hard+=n; }
    else { macro(c,r,0); macro(mirror,r,0); }
  }
  for(int r=2;r<=9;r++) for(int c=0;c<=6;c++) {
    if(floorCell(c,r) && rng.nextFloat()<0.13f) {
      macro(c,r,4); macro(12-c,r,4);
    }
  }
}
boolean floorCell(int c,int r) {
  if(c<0 || c>12 || r<0 || r>12 || (hasBase() && c==6 && r==12)) return false;
  for(int y=r*2;y<r*2+2;y++) for(int x=c*2;x<c*2+2;x++)
    if(map[y][x]>=1 && map[y][x]<=3) return false;
  return true;
}
int[] roadDistances(int sx,int sy,int minCol,int maxCol) {
  int[] distance=new int[169],queue=new int[169];
  java.util.Arrays.fill(distance,-1);
  if(!floorCell(sx,sy)) return distance;
  int head=0,tail=0,start=sy*13+sx;
  distance[start]=0; queue[tail++]=start;
  while(head<tail) {
    int u=queue[head++];
    for(int d=0;d<4;d++) {
      int x=u%13+DX[d],y=u/13+DY[d];
      if(x<minCol || x>maxCol || !floorCell(x,y)) continue;
      int v=y*13+x;
      if(distance[v]<0) { distance[v]=distance[u]+1; queue[tail++]=v; }
    }
  }
  return distance;
}
boolean validRoads() {
  int[] all=roadDistances(4,12,0,12);
  for(int r=0;r<13;r++) for(int c=0;c<13;c++)
    if(floorCell(c,r) && all[r*13+c]<0) return false;
  if(all[0]<0 || all[6]<0 || all[12]<0 || all[10*13+6]<0) return false;
  int left=roadDistances(0,0,0,5)[11*13+4];
  int right=roadDistances(12,0,7,12)[11*13+8];
  return left>=0 && left<=23 && right==left;
}

void macro(int c,int r,int value) {
  for(int y=r*2;y<r*2+2;y++) for(int x=c*2;x<c*2+2;x++) map[y][x]=value;
}
void baseWall(int kind) {
  for(int x=11;x<=14;x++) map[23][x]=kind;
  for(int y=24;y<26;y++) { map[y][11]=kind; map[y][14]=kind; }
}
void announce(String s) { message=s; bannerTimer=2.2f; }
void addScore(int n) {
  score+=n; best=max(best,score);
  if(score>=nextLife) { lives++; nextLife+=10000; announce("BONUS LIFE"); }
}

boolean canStand(Tank who,float x,float y) {
  float r=5.8f;
  if(x-r<0 || y-r<0 || x+r>WORLD || y+r>WORLD) return false;
  if(hasBase() && abs(x-104)<r+8 && abs(y-200)<r+8) return false;
  for(int yy=(int)((y-r)/TILE);yy<=(int)((y+r-0.01f)/TILE);yy++)
    for(int xx=(int)((x-r)/TILE);xx<=(int)((x+r-0.01f)/TILE);xx++)
      if(map[yy][xx]==1 || map[yy][xx]==2 || map[yy][xx]==3) return false;
  if(player!=null && player!=who && player.alive && abs(x-player.x)<12 && abs(y-player.y)<12) return false;
  if(player2!=null && player2!=who && player2.alive && abs(x-player2.x)<12 && abs(y-player2.y)<12) return false;
  for(Tank t:enemies) if(t!=who && t.alive && abs(x-t.x)<12 && abs(y-t.y)<12) return false;
  return true;
}


// Roles: assault, flanker/hunter, siege. Perception is not omniscient.
void updateEnemy(Tank t,float dt) {
  t.cool=max(0,t.cool-dt); t.memory=max(0,t.memory-dt);
  t.senseTimer-=dt; t.rest=max(0,t.rest-dt);
  if(t.shield>0) { t.intent="SPAWN"; return; }
  if(t.senseTimer<=0) {
    t.senseTimer=0.22f+(t.type==2?0.12f:0);
    if(seesPlayer(t)) { t.seenX=player.x; t.seenY=player.y; t.memory=2.5f; }
  }
  if(t.rest>0) return;
  boolean centered=abs(t.x-t.tx)<0.01f && abs(t.y-t.ty)<0.01f;
  int dodge=centered && gameTime>=t.nextDodge ? dodgeDirection(t) : -1;
  if(dodge>=0) {
    setWaypoint(t,dodge); t.nextDodge=gameTime+1.4f;
    t.aimDir=-1; t.intent="EVADE"; centered=false;
  }
  int shot=t.intent.equals("EVADE") && !centered ? -1 : aimedShot(t);
  if(shot>=0 && shotReady(t)) {
    if(t.aimDir!=shot) { t.aimDir=shot; t.aimTimer=enemyAimTime(t); }
    t.dir=shot; t.intent="AIM"; t.aimTimer-=dt;
    if(t.aimTimer<=0) { fire(t); t.aimDir=-1; t.rest=0.10f; }
    return;
  }
  t.aimDir=-1;
  if(centered) {
    int index=constrain((int)(t.y/16),0,12)*13+constrain((int)(t.x/16),0,12);
    t.visits[index]=min(8,t.visits[index]+1);
    chooseGoal(t);
    int d=routeDirection(t);
    if(d>=0) setWaypoint(t,d);
  }
  float remain=abs(t.tx-t.x)+abs(t.ty-t.y);
  if(remain<0.01f) return;
  t.dir=abs(t.tx-t.x)>0.01f ? (t.tx>t.x?1:3) : (t.ty>t.y?2:0);
  float speed=enemyMoveSpeed(t);
  float step=min(speed*dt,remain);
  float nx=t.x+DX[t.dir]*step,ny=t.y+DY[t.dir]*step;
  if(canStand(t,nx,ny)) { t.x=nx; t.y=ny; t.stuck=0; }
  else {
    t.stuck+=dt;
    if(brickAhead(t) && shotReady(t)) { t.intent="BREACH"; fire(t); }
    if(t.stuck>0.8f && !brickAhead(t)) {
      if(abs(t.x-t.fx)+abs(t.y-t.fy)>0.1f) { t.tx=t.fx; t.ty=t.fy; }
      else { t.tx=t.x; t.ty=t.y; t.visits[constrain((int)(t.y/16),0,12)*13+constrain((int)(t.x/16),0,12)]=8; }
      t.stuck=0; t.rest=0.12f;
    }
  }
}
void setWaypoint(Tank t,int d) {
  t.dir=d; t.fx=t.x; t.fy=t.y;
  t.tx=t.x+DX[d]*16; t.ty=t.y+DY[d]*16;
}
boolean brickAhead(Tank t) {
  int x=(int)((t.x+DX[t.dir]*8)/8), y=(int)((t.y+DY[t.dir]*8)/8);
  return x>=0 && x<N && y>=0 && y<N && map[y][x]==1;
}
boolean seesPlayer(Tank t) {
  if(player==null || !player.alive || player.shield>0) return false;
  int cx=constrain((int)(player.x/8),0,25),cy=constrain((int)(player.y/8),0,25);
  if(map[cy][cx]==4 && gameTime-lastPlayerShot>0.8f) return false;
  return dist(t.x,t.y,player.x,player.y)<=112 && clearRay(t.x,t.y,player.x,player.y,false);
}
boolean clearRay(float x,float y,float ex,float ey,boolean breach) {
  int steps=max(1,(int)(dist(x,y,ex,ey)/2));
  for(int i=1;i<steps;i++) {
    int cx=constrain((int)(lerp(x,ex,i/(float)steps)/8),0,25);
    int cy=constrain((int)(lerp(y,ey,i/(float)steps)/8),0,25);
    if(map[cy][cx]==2 || (!breach && map[cy][cx]==1)) return false;
  }
  return true;
}
int alignedDirection(float x,float y,float ex,float ey) {
  if(abs(x-ex)<4 && abs(y-ey)>6) return ey>y?2:0;
  if(abs(y-ey)<4 && abs(x-ex)>6) return ex>x?1:3;
  return -1;
}
boolean friendlyInLane(Tank t,float ex,float ey) {
  for(Tank q:enemies) if(q!=t && q.alive) {
    if(abs(ex-t.x)<4 && abs(q.x-t.x)<8 && (q.y-t.y)*(q.y-ey)<0) return true;
    if(abs(ey-t.y)<4 && abs(q.y-t.y)<8 && (q.x-t.x)*(q.x-ex)<0) return true;
  }
  return false;
}
int aimedShot(Tank t) {
  if(t.memory>0 && seesPlayer(t)) {
    int d=alignedDirection(t.x,t.y,player.x,player.y);
    if(d>=0 && !friendlyInLane(t,player.x,player.y)) return d;
  }
  int d=alignedDirection(t.x,t.y,104,200);
  if(d>=0 && dist(t.x,t.y,104,200)<73 && clearRay(t.x,t.y,104,200,true)
      && !friendlyInLane(t,104,200)) return d;
  return -1;
}
boolean incoming(Bullet b,float x,float y,float range) {
  if(!b.alive || b.enemy) return false;
  float along=(x-b.x)*DX[b.dir]+(y-b.y)*DY[b.dir];
  float across=abs((x-b.x)*DY[b.dir]-(y-b.y)*DX[b.dir]);
  return along>0 && along<range && across<8 && clearRay(b.x,b.y,x,y,false);
}
int dodgeDirection(Tank t) {
  for(Bullet b:bullets) if(incoming(b,t.x,t.y,44)) {
    int best=-1; float value=-10000;
    for(int i=0;i<2;i++) {
      int d=(b.dir+(i==0?1:3))%4;
      float x=t.x+DX[d]*16,y=t.y+DY[d]*16;
      if(!canStand(t,x,y)) continue;
      float v=-abs(x-t.lane*16-8)*0.05f;
      for(Bullet other:bullets) if(incoming(other,x,y,80)) v-=100;
      if(v>value) { value=v; best=d; }
    }
    if(best>=0) return best;
  }
  return -1;
}
void chooseGoal(Tank t) {
  int c=constrain((int)(t.x/16),0,12),r=constrain((int)(t.y/16),0,12);
  if(t.type==1 && t.memory>0) {
    t.goalX=constrain((int)(t.seenX/16),0,12);
    t.goalY=constrain((int)(t.seenY/16),0,12);
    if(seesPlayer(t)) {
      int nx=t.goalX+DX[player.dir],ny=t.goalY+DY[player.dir];
      if(floorCell(nx,ny)) { t.goalX=nx; t.goalY=ny; }
    }
    t.intent="HUNT"; return;
  }
  if(t.phase==0 && r>=5) t.phase=1;
  if(t.phase==1 && r>=9) t.phase=2;
  if(t.phase<2) {
    t.goalX=t.type==1 ? (t.lane<6?1:11) : t.lane;
    t.goalY=t.phase==0?5:9;
    t.intent=t.type==1?"FLANK":"ADVANCE";
  } else {
    t.goalX=t.type==1 ? (t.lane<6?4:8) : 6;
    t.goalY=t.type==1 ? 12 : 11;
    t.intent=t.type==2?"SIEGE":"ASSAULT";
  }
  if(cellWeight(t.goalX,t.goalY)<0) {
    int bx=t.goalX,by=t.goalY; float value=100000;
    for(int y=1;y<12;y++) for(int x=0;x<13;x++) if(floorCell(x,y)) {
      float v=abs(x-bx)+abs(y-by)+0.02f*(abs(c-x)+abs(r-y));
      if(v<value) { value=v; t.goalX=x; t.goalY=y; }
    }
  }
  if(c==t.goalX && r==t.goalY && t.phase<2) { t.phase++; chooseGoal(t); }
}
// Route between tactical goals using traffic, exposure, danger and lane costs.
int routeDirection(Tank t) {
  int sx=constrain((int)(t.x/16),0,12),sy=constrain((int)(t.y/16),0,12);
  int target=t.goalY*13+t.goalX,start=sy*13+sx;
  if(start==target) return -1;
  float[] cost=new float[169]; boolean[] done=new boolean[169]; int[] first=new int[169];
  java.util.Arrays.fill(cost,100000); java.util.Arrays.fill(first,-1); cost[start]=0;
  for(int n=0;n<169;n++) {
    int u=-1;
    for(int i=0;i<169;i++) if(!done[i] && (u<0 || cost[i]<cost[u])) u=i;
    if(u<0 || cost[u]>=100000) break;
    if(u==target) return first[u];
    done[u]=true;
    for(int k=0;k<4;k++) {
      int d=(k+t.bias)%4,x=u%13+DX[d],y=u/13+DY[d];
      if(x<0 || x>12 || y<0 || y>12 || (x==6 && y==12)) continue;
      int w=cellWeight(x,y); if(w<0) continue;
      int v=y*13+x; float px=x*16+8,py=y*16+8;
      float edge=1+(w>1?(t.type==2?1.8f:4.2f):0);
      edge+=abs(x-t.lane)*(t.phase<2?0.13f:0.02f)+t.visits[v]*0.24f;
      edge+=((v*17+t.bias*31)%11)*0.025f;
      if(u==start && d!=t.dir) edge+=0.2f;
      for(Tank q:enemies) if(q!=t && q.alive &&
        ((abs(q.x-px)<13 && abs(q.y-py)<13) || (abs(q.tx-px)<2 && abs(q.ty-py)<2))) edge+=14;
      for(Bullet b:bullets) if(incoming(b,px,py,96)) edge+=18;
      if(t.memory>0 && alignedDirection(px,py,t.seenX,t.seenY)>=0
         && clearRay(px,py,t.seenX,t.seenY,false)) edge+=t.type==1?3.0f:0.8f;
      float alt=cost[u]+edge;
      if(alt<cost[v]) { cost[v]=alt; first[v]=u==start?d:first[u]; }
    }
  }
  for(int k=0;k<4;k++) {
    int d=(k+t.bias)%4;
    if(canStand(t,t.x+DX[d]*16,t.y+DY[d]*16)) return d;
  }
  return -1;
}



boolean wallAhead(Tank t) {
  int x=constrain((int)((t.x+DX[t.dir]*9)/8),0,25);
  int y=constrain((int)((t.y+DY[t.dir]*9)/8),0,25);
  return map[y][x]==1 || map[y][x]==2;
}
int cellWeight(int x,int y) {
  int w=1;
  for(int r=y*2;r<y*2+2;r++) for(int c=x*2;c<x*2+2;c++) {
    if(map[r][c]==2 || map[r][c]==3) return -1;
    if(map[r][c]==1) w=4;
  }
  return w;
}

boolean hitTank(Bullet b,Tank t) { return abs(b.x-t.x)<6.5f && abs(b.y-t.y)<6.5f; }

void fail(String why) { state=LOST; message=why; bannerTimer=99; clearKeys(); }
void dropPower() {
  for(int attempt=0;attempt<100;attempt++) {
    float x=8+16*(int)random(13), y=8+16*(int)random(3,12);
    if(canStand(null,x,y)) { powers.add(new Power(x,y,(int)random(6))); return; }
  }
}

void clearUnderTank(Tank t) {
  for(int y=max(0,(int)((t.y-6)/8));y<=min(25,(int)((t.y+5.9f)/8));y++)
    for(int x=max(0,(int)((t.x-6)/8));x<=min(25,(int)((t.x+5.9f)/8));x++)
      if((y==23 && x>=11 && x<=14) || (y>=24 && (x==11 || x==14))) map[y][x]=0;
}
void burst(float x,float y,int count,int c) {
  for(int i=0;i<count;i++) effects.add(new Spark(x,y,c));
}
class Tank {
  float x,y,tx,ty,fx,fy,cool=0,shield=0,stuck=0;
  int dir=0,type,hp,level=0,chassis=0,maxHP=1; boolean enemy,alive=true;
  float stun=0; boolean boss=false;
  int lane=3,phase=0,goalX=6,goalY=11,bias=0,aimDir=-1;
  float seenX=0,seenY=0,memory=0,senseTimer=0,aimTimer=0,rest=0,nextDodge=0;
  int[] visits=new int[169];
  String intent="ADVANCE";
  Tank(float x,float y,boolean enemy,int type) {
    this.x=x; this.y=y; tx=fx=x; ty=fy=y; this.enemy=enemy; this.type=type;
    hp=type==2 ? 3 : 1; maxHP=hp; dir=enemy ? 2 : 0; bias=(int)random(4);
  }
}
class Bullet {
  float x,y; int dir,power; boolean enemy,alive=true; Tank owner;
  Bullet(Tank t) {
    owner=t; dir=t.dir; enemy=t.enemy; power=t.level;
    x=t.x+DX[dir]*6; y=t.y+DY[dir]*6;
  }
}
