void pixelText(String s, float x, float y, int scale, int ink) {
  g.noStroke(); g.fill(ink); s = s.toUpperCase();
  for (int i=0; i<s.length(); i++) {
    int n=fontChars.indexOf(s.charAt(i));
    if (n<0) continue;
    String bits=fontBits[n];
    for (int p=0; p<15; p++) if (bits.charAt(p)=='1')
      g.rect(round(x)+(i*4+p%3)*scale, round(y)+(p/3)*scale, scale, scale);
  }
}
void centered(String s, float y, int scale, int ink) {
  pixelText(s, (352-(s.length()*4-1)*scale)/2.0f, y, scale, ink);
}
void box(float x,float y,float w,float h,int ink) {
  g.noStroke();g.fill(ink);g.rect(x,y,w,1);g.rect(x,y+h-1,w,1);
