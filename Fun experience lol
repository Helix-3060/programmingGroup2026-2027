int globalWave() { return gameMode==STORY?(stage-1)*3+waveNumber:waveNumber; }
float threat() { return min(10,max(0,globalWave()-1)); }
float difficultyScale() { return difficulty==0?0.80f:difficulty==1?1.0f:1.17f; }
int waveSize() {
  int n=gameMode==ZOMBIES?8:5;
  return min(gameMode==ZOMBIES?24:18,n+difficulty*2+(globalWave()-1)*2);
}
int enemyCap() {
  int cap=gameMode==ZOMBIES?4:2;
  cap+=difficulty+(globalWave()-1)/3;
  cap=min(gameMode==ZOMBIES?8:5,cap);
  if(baseHP==1) cap=max(gameMode==ZOMBIES?3:2,cap-1);
  return cap;
}
float enemyMoveSpeed(Tank t) {
  float base=gameMode==ZOMBIES?(t.type==1?34:t.type==2?18:23):(t.type==1?27:t.type==2?18:22);
  return min(gameMode==ZOMBIES?46:42,(base+threat()*1.3f)*difficultyScale());
}
float enemyShotSpeed() { return min(128,(82+threat()*3.5f)*difficultyScale()); }
float enemyReload() { return max(1.0f,(2.0f-threat()*.07f)/difficultyScale()); }
float enemyAimTime(Tank t) { return max(.26f,(t.type==1?.50f:.66f)/difficultyScale()-threat()*.012f); }
float spawnDelay() { return max(gameMode==ZOMBIES?.65f:1.5f,(gameMode==ZOMBIES?2.1f:4.0f)/difficultyScale()-threat()*.16f); }
float waveBreak() { return difficulty==0?8:difficulty==1?6:4; }
float activeFor(Tank t) { return t==player2?skillActive2:skillActive; }
float cooldownFor(Tank t) { return t==player2?skillCD2:skillCD; }

Tank createPlayer(float x,float y,int level) {
  return createPilot(x,y,level,selectedTank);
}
Tank createPilot(float x,float y,int level,int chassis) {
  Tank p=new Tank(x,y,false,0);
  p.chassis=chassis; p.maxHP=gameMode==VERSUS?2:TANK_HP[chassis]; p.hp=p.maxHP;
  p.level=gameMode==VERSUS?0:level; p.shield=gameMode==VERSUS?2:4;
  return p;
}
void newGame() {
  stage=1; score=0; lives=initialLives(); nextLife=10000;
  player=null; player2=null; wins1=wins2=0; duelRound=1;
  if(gameMode==VERSUS) startDuelRound(); else startStage();
}
void startStage() {
  int level=player==null?0:player.level;
  enemies.clear(); bullets.clear(); effects.clear(); powers.clear();
  player2=null; baseAlive=true; baseHP=3; baseFlash=0; lastPlayerShot=-100;
  freezeTimer=fortTimer=respawnTimer=gameTime=0;
  skillCD=skillActive=empRing=reliefTimer=baseGuard=0;
  skillCD2=skillActive2=empRing2=0; accumulator=0;
  repairKits=difficulty==0?2:1; waveNumber=1;
  relaysDone=0; relayHold=0; relayOn[0]=relayOn[1]=false;
  relayX[0]=40;relayY[0]=40;relayX[1]=168;relayY[1]=120;
  commanderDown=false; waitingObjective=false;
  buildMap(); player=createPlayer(72,200,level);
  if(gameMode==STORY && stage==2) placeRelays();
  prepareWave(false);
  state=gameMode==STORY?BRIEF:PLAY; clearKeys();
}
void prepareWave(boolean reward) {
  spawned=killed=0; totalEnemies=waveSize(); waitingObjective=false;
  bullets.clear();
  intermission=waveBreak(); spawnTimer=intermission;
  if(reward) {
    addScore(300+globalWave()*50);
    if(player!=null && player.alive) player.hp=min(player.maxHP,player.hp+1);
    repairKits=min(2,repairKits+1);
    if((waveNumber-1)%3==0) baseHP=min(3,baseHP+1);
    announce("WAVE "+waveNumber+" - ARMOR +1 / KIT +1");
  } else announce("WAVE 1 - GET READY");
}
void placeRelays() {
  for(int i=0;i<2;i++) {
    float bestDistance=10000,bx=40,by=40;
    for(int r=2;r<=9;r++) for(int c=1;c<=11;c++) if(floorCell(c,r)) {
      float x=c*16+8,y=r*16+8,d=dist(x,y,relayX[i],relayY[i]);
      if(i==1 && dist(x,y,relayX[0],relayY[0])<48) continue;
      if(d<bestDistance) { bestDistance=d; bx=x; by=y; }
    }
    relayX[i]=bx; relayY[i]=by;
  }
}
void spawnEnemy() {
  float[] xs=gameMode==ZOMBIES?new float[]{8,104,200,8,200}:new float[]{8,104,200};
  float[] ys=gameMode==ZOMBIES?new float[]{8,8,8,104,104}:new float[]{8,8,8};
  int first=(int)random(xs.length);
  for(int j=0;j<xs.length;j++) {
    int p=(first+j)%xs.length; float x=xs[p],y=ys[p];
    if(!canStand(null,x,y)) continue;
    if(player!=null && player.alive && dist(x,y,player.x,player.y)<32) continue;
    int type=(spawned+globalWave())%6==0?2:spawned%3==1?1:0;
    Tank t=new Tank(x,y,true,type);
    t.maxHP=t.hp=type==2?(globalWave()>=7 && difficulty>0?4:3):1;
    t.boss=gameMode==STORY && stage==3 && waveNumber==3 && spawned==totalEnemies-1;
    if(t.boss) {t.type=2;t.maxHP=t.hp=6+difficulty*2;}
    t.shield=1.1f;t.lane=x<50?3:x>150?9:spawned%2==0?3:9;
    enemies.add(t);spawned++;spawnTimer=spawnDelay();return;
  }
  spawnTimer=.3f;
}
void activateSkill() { activateFor(player); }
void activateFor(Tank p) {
  if(state!=PLAY || p==null || !p.alive || (gameMode==VERSUS && roundOver)) return;
  if(cooldownFor(p)>0 || p.stun>0) return;
  boolean second=p==player2;
  float cd=gameMode==VERSUS?12:SKILL_COOLDOWN[p.chassis];
  float duration=0,ring=0;
  if(p.chassis==0) {
    ring=.55f;
    if(gameMode==VERSUS) {
      Tank foe=second?player:player2;
      if(foe.alive && foe.shield<=0 && dist(p.x,p.y,foe.x,foe.y)<=70) foe.stun=.9f;
    } else for(Tank t:enemies) if(t.alive && dist(p.x,p.y,t.x,t.y)<=80) t.stun=max(t.stun,3.5f);
    for(Bullet b:bullets) if(b.owner!=p && (gameMode==VERSUS || b.enemy) && dist(p.x,p.y,b.x,b.y)<=96) b.alive=false;
    p.shield=max(p.shield,gameMode==VERSUS?.5f:.8f);
  } else if(p.chassis==1) {
    duration=gameMode==VERSUS?2.5f:3.5f; p.shield=max(p.shield,gameMode==VERSUS?.5f:1.2f);
  } else {duration=gameMode==VERSUS?2:5;p.shield=max(p.shield,duration);}
  if(second) {skillCD2=cd;skillActive2=duration;empRing2=ring;}
  else {skillCD=cd;skillActive=duration;empRing=ring;}
  announce((second?"P2 ":"P1 ")+SKILL_NAMES[p.chassis]+" ACTIVE");
}
void useRepair() {
  if(gameMode==VERSUS || state!=PLAY || player==null || !player.alive) return;
  if(gameMode==STORY && stage==2 && nearRelay()>=0) return;
  if(repairKits==0) {announce("NO REPAIR KIT LEFT");return;}
  if(dist(player.x,player.y,104,200)>48) {announce("RETURN TO BASE / E REPAIR");return;}
  if(baseHP>=3 && player.hp>=player.maxHP) return;
  repairKits--;baseHP=min(3,baseHP+1);player.hp=min(player.maxHP,player.hp+1);
  baseGuard=max(baseGuard,2);player.shield=max(player.shield,1.5f);
  announce("REPAIR +1 BASE / +1 ARMOR");
}
int nearRelay() {
  if(player==null || !player.alive) return -1;
  for(int i=0;i<2;i++) if(!relayOn[i] && dist(player.x,player.y,relayX[i],relayY[i])<=18) return i;
  return -1;
}
void updateRelays(float dt) {
  if(gameMode!=STORY || stage!=2) return;
  int relay=nearRelay();
  if(relay>=0 && down('E')) {
    relayHold+=dt;
    if(relayHold>=2) {relayOn[relay]=true;relaysDone++;relayHold=0;announce("RELAY ONLINE "+relaysDone+"/2");}
  } else relayHold=0;
}
void movePlayer(int d,float dt) { movePilot(player,d,dt); }
void movePilot(Tank p,int d,float dt) {
  if(p.stun>0) return;
  if(p.chassis==2 && activeFor(p)>0) {p.dir=d;return;}
  if((d%2)!=(p.dir%2)) {
    float x=p.x,y=p.y;
    if(d%2==0)x=round(x/8)*8;else y=round(y/8)*8;
    if(canStand(p,x,y)){p.x=x;p.y=y;}
  }
  p.dir=d;
  float speed=gameMode==VERSUS?44:TANK_SPEED[p.chassis];
  if(p.chassis==1 && activeFor(p)>0) speed*=gameMode==VERSUS?1.4f:1.6f;
  float nx=p.x+DX[d]*speed*dt,ny=p.y+DY[d]*speed*dt;
  if(canStand(p,nx,ny)){p.x=nx;p.y=ny;}
}
boolean shotReady(Tank t) {
  if(!t.alive || t.cool>0 || t.stun>0) return false;
  if(t.enemy && gameMode==ZOMBIES) return false;
  int count=0;for(Bullet b:bullets)if(b.alive && b.owner==t)count++;
  int cap=gameMode==VERSUS?1:t.enemy?1:t.level>=2 || (t.chassis==2 && activeFor(t)>0)?2:1;
  return count<cap;
}
void fire(Tank t) {
  if(!shotReady(t))return;
  bullets.add(new Bullet(t));
  if(t.enemy)t.cool=enemyReload();
  else {
    lastPlayerShot=gameTime;
    t.cool=gameMode==VERSUS?.35f:t.level>=1?TANK_FAST_RELOAD[t.chassis]:TANK_RELOAD[t.chassis];
    if(t.chassis==2 && activeFor(t)>0)t.cool*=gameMode==VERSUS?.85f:.65f;
  }
}
void updateBullet(Bullet b,float dt) {
  if(!b.alive)return;
  float speed=gameMode==VERSUS?132:b.enemy?enemyShotSpeed():b.power>=1?176:132;
  int steps=max(1,(int)ceil(speed*dt/1.5f));
  for(int step=0;step<steps && b.alive;step++) {
    b.x+=DX[b.dir]*speed*dt/steps;b.y+=DY[b.dir]*speed*dt/steps;
    if(b.x<0 || b.y<0 || b.x>=WORLD || b.y>=WORLD){b.alive=false;break;}
    if(hasBase() && baseAlive && abs(b.x-104)<8 && abs(b.y-200)<8) {
      b.alive=false;if(b.enemy)damageBase();break;
    }
    int cx=(int)(b.x/8),cy=(int)(b.y/8),tile=map[cy][cx];
    if(tile==1 || tile==2) {
      if(tile==1 || (!b.enemy && b.power>=3)) {
        if(b.dir%2==0)for(int x=max(0,(int)((b.x-5)/8));x<=min(25,(int)((b.x+5)/8));x++) {
          if(map[cy][x]==1 || (map[cy][x]==2 && b.power>=3))map[cy][x]=0;
        }
        else for(int y=max(0,(int)((b.y-5)/8));y<=min(25,(int)((b.y+5)/8));y++) {
          if(map[y][cx]==1 || (map[y][cx]==2 && b.power>=3))map[y][cx]=0;
        }
      }
      burst(b.x,b.y,5,tile==1?YELLOW:STEEL);b.alive=false;break;
    }
    for(Bullet other:bullets)if(other!=b && other.alive &&
      (gameMode==VERSUS?other.owner!=b.owner:other.enemy!=b.enemy) && abs(b.x-other.x)<3 && abs(b.y-other.y)<3) {
      b.alive=false;other.alive=false;burst(b.x,b.y,3,PALE);break;
    }
    if(!b.alive)break;
    if(gameMode==VERSUS) {
      Tank target=b.owner==player?player2:player;
      if(target!=null && target.alive && hitTank(b,target)) {
        b.alive=false;
        if(target.shield<=0){target.hp--;target.shield=.8f;burst(target.x,target.y,7,YELLOW);if(target.hp<=0)target.alive=false;}
      }
    } else if(b.enemy) {
      if(player!=null && player.alive && hitTank(b,player)){b.alive=false;hitPlayer();}
    } else for(Tank t:enemies)if(t.alive && hitTank(b,t)) {
      b.alive=false;
      if(t.shield<=0){t.hp--;burst(t.x,t.y,4,PALE);if(t.hp<=0)destroyEnemy(t,true);}
      break;
    }
  }
}
void destroyEnemy(Tank t,boolean drop) {
  if(!t.alive)return;
  t.alive=false;killed++;addScore(t.boss?1500:(t.type+1)*100);
  if(t.boss)commanderDown=true;
  burst(t.x,t.y,12,gameMode==ZOMBIES?ZOMBIE_COLOR:YELLOW);
  if(drop && (killed%3==0 || random(1)<.08f))dropPower();
}
void collect(int kind) {
  addScore(500);
  if(kind==0){player.level=min(3,player.level+1);announce("WEAPON UPGRADE");}
  if(kind==1){player.shield=10;announce("SHIELD 10S");}
  if(kind==2){
    for(Tank t:enemies)if(t.alive){if(t.boss){t.hp=max(1,t.hp-3);}else destroyEnemy(t,false);}
    announce("AREA BLAST");
  }
  if(kind==3){freezeTimer=8;announce("ENEMIES FROZEN");}
  if(kind==4){
    baseWall(2);fortTimer=12;
    for(Tank t:enemies)if(t.alive)clearUnderTank(t);
    if(player!=null && player.alive)clearUnderTank(player);
    announce("BASE FORTIFIED");
  }
  if(kind==5){lives=min(9,lives+1);announce("EXTRA LIFE");}
}
void updateZombie(Tank t,float dt) {
  t.cool=max(0,t.cool-dt);if(t.shield>0)return;
  boolean chase=player!=null && player.alive && dist(t.x,t.y,player.x,player.y)<112;
  float gx=chase?player.x:104,gy=chase?player.y:184;
  if(chase && abs(t.x-player.x)<17 && abs(t.y-player.y)<17 && clearRay(t.x,t.y,player.x,player.y,false)) {
    t.intent="BITE";if(t.cool<=0){hitPlayer();t.cool=1.25f;}return;
  }
  if(dist(t.x,t.y,104,200)<24 && clearRay(t.x,t.y,104,200,false)) {
    t.intent="BITE";if(t.cool<=0){damageBase();t.cool=1.65f;}return;
  }
  if(abs(t.x-t.tx)+abs(t.y-t.ty)<.02f) {
    t.goalX=constrain((int)(gx/16),0,12);t.goalY=constrain((int)(gy/16),0,12);
    if(t.goalX==6 && t.goalY==12)t.goalY=11;
    t.phase=2;t.lane=t.goalX;t.memory=0;
    int d=routeDirection(t);if(d>=0)setWaypoint(t,d);
  }
  float remain=abs(t.tx-t.x)+abs(t.ty-t.y);if(remain<.01f)return;
  t.dir=abs(t.tx-t.x)>.01f?(t.tx>t.x?1:3):(t.ty>t.y?2:0);
  float step=min(enemyMoveSpeed(t)*dt,remain);
  float nx=t.x+DX[t.dir]*step,ny=t.y+DY[t.dir]*step;
  if(canStand(t,nx,ny)){t.x=nx;t.y=ny;t.stuck=0;t.intent="HUNT";}
  else {
    t.stuck+=dt;t.intent="CLAW";
    if(brickAhead(t) && t.cool<=0) {
      int cx=constrain((int)((t.x+DX[t.dir]*9)/8),0,25),cy=constrain((int)((t.y+DY[t.dir]*9)/8),0,25);
      for(int i=-1;i<=1;i++) {
        int x=constrain(cx+(t.dir%2==0?i:0),0,25),y=constrain(cy+(t.dir%2==1?i:0),0,25);
        if(map[y][x]==1)map[y][x]=0;
      }
      t.cool=t.type==2?.85f:1.6f;burst(cx*8+4,cy*8+4,4,YELLOW);
    }
    if(t.stuck>1.2f && !brickAhead(t)){t.tx=t.fx;t.ty=t.fy;t.stuck=0;}
  }
}
void tick(float dt) {
  if(gameMode==VERSUS){tickDuel(dt);return;}
  gameTime+=dt;bannerTimer=max(0,bannerTimer-dt);baseFlash=max(0,baseFlash-dt);
  baseGuard=max(0,baseGuard-dt);freezeTimer=max(0,freezeTimer-dt);
  reliefTimer=max(0,reliefTimer-dt);intermission=max(0,intermission-dt);
  skillCD=max(0,skillCD-dt);skillActive=max(0,skillActive-dt);empRing=max(0,empRing-dt);
  if(fortTimer>0){
    fortTimer-=dt;
    if(fortTimer<=0){fortTimer=0;baseWall(1);for(Tank t:enemies)if(t.alive)clearUnderTank(t);if(player!=null && player.alive)clearUnderTank(player);}
  }
  if(player!=null && player.alive) {
    player.cool=max(0,player.cool-dt);player.shield=max(0,player.shield-dt);
    int d=directionHeld(lastDir)?lastDir:-1;
    if(d<0)for(int i=0;i<4;i++)if(directionHeld(i)){d=i;break;}
    if(d>=0)movePlayer(d,dt);
    if(down(' ') || down('J'))fire(player);
  } else {
    respawnTimer-=dt;
    if(respawnTimer<=0){float[] sx={72,136,40,168};for(float x:sx)if(canStand(null,x,200)){player=createPlayer(x,200,player==null?0:max(0,player.level-1));break;}}
  }
  updateRelays(dt);spawnTimer-=dt;
  if(player!=null && player.alive && reliefTimer<=0 && intermission<=0 && spawned<totalEnemies && enemies.size()<enemyCap() && spawnTimer<=0)spawnEnemy();
  for(Tank t:enemies)if(t.alive && state==PLAY){
    t.shield=max(0,t.shield-dt);t.stun=max(0,t.stun-dt);
    if(freezeTimer<=0 && reliefTimer<=0 && t.stun<=0){if(gameMode==ZOMBIES)updateZombie(t,dt);else updateEnemy(t,dt);}
  }
  for(int i=0;i<bullets.size() && state==PLAY;i++)updateBullet(bullets.get(i),dt);
  for(int i=bullets.size()-1;i>=0;i--)if(!bullets.get(i).alive)bullets.remove(i);
  for(int i=enemies.size()-1;i>=0;i--)if(!enemies.get(i).alive)enemies.remove(i);
  if(state!=PLAY)return;
  for(int i=powers.size()-1;i>=0;i--){
    Power p=powers.get(i);p.ttl-=dt;
    if(player!=null && player.alive && abs(player.x-p.x)<11 && abs(player.y-p.y)<11){collect(p.kind);powers.remove(i);}
    else if(p.ttl<=0)powers.remove(i);
  }
  updateSparks(dt);
  if(killed>=totalEnemies && enemies.isEmpty() && baseAlive && player!=null && player.alive) {
    if(gameMode==STORY && waveNumber>=3) {
      if(stage==2 && relaysDone<2){if(!waitingObjective){announce("HOLD E AT BOTH RELAYS");waitingObjective=true;}return;}
      if(stage==3 && !commanderDown)return;
      addScore(1000*stage);state=stage==3?WIN:CLEAR;clearKeys();
      message=stage==3?"KOWLOON IS FREE":"MISSION COMPLETE";
    } else {waveNumber++;prepareWave(true);}
  }
}
void updateSparks(float dt) {
  for(int i=effects.size()-1;i>=0;i--){Spark s=effects.get(i);s.life-=dt;s.x+=s.vx*dt;s.y+=s.vy*dt;if(s.life<=0)effects.remove(i);}
}

// Local duel: normalized armor/speed/fire rate, different bounded skills.
void buildDuelMap(int seed) {
  mapSeed=seed;for(int[] row:map)java.util.Arrays.fill(row,0);
  java.util.Random rng=new java.util.Random(seed);
  for(int r=1;r<=11;r++)for(int c=2;c<=6;c++) {
    if(r==5 || r==7 || (r==6 && (c==2 || c==3)))continue;
    if(rng.nextFloat()>.65f)continue;
    int kind=rng.nextFloat()<.20f?2:1;
    macro(c,r,kind);macro(12-c,r,kind);
    if(!duelRoadsValid()){macro(c,r,0);macro(12-c,r,0);}
  }
  macro(6,6,1); // Central cover, with two protected approach routes.
  if(!duelRoadsValid())macro(6,6,0);
}
boolean duelRoadsValid() {
  int[] distances=roadDistances(1,6,0,12);
  if(distances[6*13+11]<0)return false;
  for(int r=0;r<13;r++)for(int c=0;c<13;c++)if(floorCell(c,r) && distances[r*13+c]<0)return false;
  return true;
}
void startDuelRound() {
  enemies.clear();bullets.clear();effects.clear();powers.clear();player=player2=null;
  baseAlive=false;baseHP=0;baseGuard=0;gameTime=0;accumulator=0;
  int seed=FIXED_SEED>=0?(FIXED_SEED+duelRound*1009)%1000000:(int)random(1000000);
  buildDuelMap(seed);
  player=createPilot(24,104,0,selectedTank);player.dir=1;
  player2=createPilot(184,104,0,selectedTank2);player2.dir=3;
  skillCD=skillCD2=skillActive=skillActive2=empRing=empRing2=0;
  roundClock=90;roundWait=2;roundOver=false;state=PLAY;clearKeys();
  announce("ROUND "+duelRound+" - FIRST TO 5");
}
boolean duelDirectionHeld(int index,int d) {
  int[] p1={'W','D','S','A'},p2={UP,RIGHT,DOWN,LEFT};return down(index==0?p1[d]:p2[d]);
}
void updateDuelPilot(Tank p,int index,float dt) {
  p.cool=max(0,p.cool-dt);p.shield=max(0,p.shield-dt);p.stun=max(0,p.stun-dt);
  if(!p.alive || p.stun>0)return;
  int last=index==0?lastDir:lastDir2,d=duelDirectionHeld(index,last)?last:-1;
  if(d<0)for(int i=0;i<4;i++)if(duelDirectionHeld(index,i)){d=i;break;}
  if(d>=0)movePilot(p,d,dt);
  if(index==0?down(' '):down(ENTER)||down(RETURN)||down('/'))fire(p);
}
void finishRound(int winner) {
  if(roundOver)return;
  roundOver=true;roundWait=3;bullets.clear();clearKeys();
  if(winner==1)wins1++;if(winner==2)wins2++;
  announce(winner==0?"ROUND DRAW":"PLAYER "+winner+" WINS ROUND");
  if(wins1>=5 || wins2>=5){state=WIN;message="PLAYER "+(wins1>=5?1:2)+" WINS MATCH";}
}
void tickDuel(float dt) {
  gameTime+=dt;bannerTimer=max(0,bannerTimer-dt);updateSparks(dt);
  if(roundWait>0){roundWait=max(0,roundWait-dt);if(roundWait==0 && roundOver){duelRound++;startDuelRound();}return;}
  roundClock=max(0,roundClock-dt);
  skillCD=max(0,skillCD-dt);skillCD2=max(0,skillCD2-dt);
  skillActive=max(0,skillActive-dt);skillActive2=max(0,skillActive2-dt);
  empRing=max(0,empRing-dt);empRing2=max(0,empRing2-dt);
  updateDuelPilot(player,0,dt);updateDuelPilot(player2,1,dt);
  for(int i=0;i<bullets.size();i++)updateBullet(bullets.get(i),dt);
  for(int i=bullets.size()-1;i>=0;i--)if(!bullets.get(i).alive)bullets.remove(i);
  if(!player.alive || !player2.alive)finishRound(!player.alive && !player2.alive?0:player.alive?1:2);
  else if(roundClock<=0)finishRound(player.hp==player2.hp?0:player.hp>player2.hp?1:2);
}

