void hitPlayer() {
  if(player==null || !player.alive || player.shield>0) return;
  player.hp--; burst(player.x,player.y,7,YELLOW);
  if(player.hp>0) { player.shield=1.0f; announce("ARMOR HIT - "+player.hp+" HP"); return; }
  player.alive=false; lives--; skillActive=0;
  skillCD=max(skillCD,8); reliefTimer=3;
  for(Bullet b:bullets) if(b.enemy) b.alive=false;
  if(lives<=0) fail("NO TANKS LEFT");
  else { respawnTimer=1.2f; spawnTimer=max(spawnTimer,4); announce("REDEPLOYING - COVER PROVIDED"); }
}
void damageBase() {
  if(!baseAlive || baseGuard>0) return;
  baseHP=max(0,baseHP-1); baseFlash=0.8f; baseGuard=1.25f;
  burst(104,200,baseHP==0?24:10,YELLOW);
  if(baseHP==0) { baseAlive=false; fail("BASE DESTROYED"); }
  else announce("BASE HIT - "+baseHP+" HP / E REPAIR");
}









