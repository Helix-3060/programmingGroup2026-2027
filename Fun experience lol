void draw() {
  int now=millis();float dt=min((now-lastMillis)/1000.0f,.08f);lastMillis=now;
  if(!focused && state==PLAY){state=PAUSE;clearKeys();}
  if(state==PLAY){accumulator+=dt;while(accumulator>=1.0f/60 && state==PLAY){tick(1.0f/60);accumulator-=1.0f/60;}}
  else accumulator=0;
  g.beginDraw();g.noStroke();g.background(BG);
  if(state==MENU)renderMenu();
  else if(state==HELP)renderHelp();
  else if(state==BRIEF)renderBrief();
  else {
    renderGame();
    if(state==PAUSE)renderOverlay("PAUSED","P / ENTER RESUME");
    if(state==LOST)renderOverlay("MISSION FAILED",message);
    if(state==CLEAR)renderOverlay("CHAPTER COMPLETE","ENTER NEXT CHAPTER");
    if(state==WIN)renderOverlay(gameMode==VERSUS?message:"KOWLOON LIBERATED","ENTER RESTART / M MENU");
  }
  g.endDraw();image(g,0,0,width,height);
}
void keyPressed() {
  int k=keyCode;if(key==ESC){key=0;k=27;}
  if(k<0 || k>=held.length || held[k])return;
  held[k]=true;
  if(k=='M'){state=MENU;clearKeys();return;}
  if(state==MENU){
    if(k>='1' && k<='3'){selectedTank=k-'1';menuPlayer=0;return;}
    if(k>='4' && k<='6' && gameMode==VERSUS){selectedTank2=k-'4';menuPlayer=1;return;}
    if(k==TAB && gameMode==VERSUS){menuPlayer=1-menuPlayer;return;}
    if(k=='C'){if(gameMode!=VERSUS)difficulty=(difficulty+1)%3;return;}
    if(k>=112 && k<=115){gameMode=k-112;menuPlayer=0;return;}
    if(k==LEFT || k=='A' || k==RIGHT || k=='D'){
      int step=k==LEFT || k=='A'?2:1;
      if(gameMode==VERSUS && menuPlayer==1)selectedTank2=(selectedTank2+step)%3;
      else selectedTank=(selectedTank+step)%3;return;
    }
    if(k=='H'){state=HELP;return;}
  }
  if(k=='R' && state!=MENU && state!=HELP){newGame();return;}
  if(k==27 || k=='P'){
    if(state==PLAY){state=PAUSE;clearKeys();}
    else if(state==PAUSE){state=PLAY;clearKeys();}
    else if(state==HELP){state=MENU;clearKeys();}
    return;
  }
  if(state==PLAY){
    if(gameMode==VERSUS){
      int[] a={'W','D','S','A'},b={UP,RIGHT,DOWN,LEFT};
      for(int i=0;i<4;i++){if(k==a[i])lastDir=i;if(k==b[i])lastDir2=i;}
      if(roundWait<=0){if(k=='Q')activateFor(player);if(k==SHIFT || k=='.')activateFor(player2);}
      return;
    }
    int d=directionKey(k);if(d>=0)lastDir=d;
    if(k=='Q'){activateSkill();return;}
    if(k=='E'){useRepair();return;}
  }
  if(k==ENTER || k==RETURN){
    if(state==MENU || state==LOST || state==WIN)newGame();
    else if(state==BRIEF){state=PLAY;clearKeys();}
    else if(state==CLEAR){stage++;lives=min(9,lives+1);startStage();}
    else if(state==PAUSE){state=PLAY;clearKeys();}
    else if(state==HELP){state=MENU;clearKeys();}
  }
}
void mousePressed() {
  if(state==MENU){
    for(int i=0;i<4;i++)if(mouseIn(10+i*84,54,80,17)){gameMode=i;menuPlayer=0;return;}
    if(gameMode!=VERSUS)for(int i=0;i<3;i++)if(mouseIn(10+i*112,89,108,15)){difficulty=i;return;}
    for(int i=0;i<3;i++)if(mouseIn(10+i*112,112,108,88)){
      if(gameMode==VERSUS && menuPlayer==1)selectedTank2=i;else selectedTank=i;return;
    }
    if(gameMode==VERSUS && mouseIn(10,204,332,12)){menuPlayer=1-menuPlayer;return;}
    if(mouseIn(10,222,234,20))newGame();
    else if(mouseIn(254,222,88,20))state=HELP;
  }else if(state==PLAY){
    if(mouseIn(264,205,72,15)){if(gameMode!=VERSUS)activateSkill();}
    else if(mouseIn(264,224,72,12)){if(gameMode!=VERSUS)useRepair();}
    else if(mouseIn(264,242,72,12)){state=PAUSE;clearKeys();}
  }else if(state==PAUSE && mouseIn(264,242,72,12)){state=PLAY;clearKeys();}
  else if(state==BRIEF && mouseIn(82,225,188,20)){state=PLAY;clearKeys();}
}
